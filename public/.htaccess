RewriteEngine On

# 1. Redirect ALL HTTP traffic (both www and non-www) to HTTPS
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Optional: Force everything to the non-www version for consistency
RewriteCond %{HTTP_HOST} ^www\.watchdognepal\.com [NC]
RewriteRule ^(.*)$ https://watchdognepal.com/$1 [L,R=301]
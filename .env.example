# Example environment variables for watchdognepal.com
# Copy this file to `.env` and fill in real values (do NOT commit .env to git).

# Django secret key (required)
SECRET_KEY=changeme_replace_with_a_secure_value

# Debug mode (True/False). For local testing you can set True.
DEBUG=False

# Database settings (defaults to MySQL in settings.py)
# For a quick local run using SQLite, set DB_ENGINE=django.db.backends.sqlite3 and DB_NAME=db.sqlite3
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Hosts allowed by Django (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── AI / Caption Generation ─────────────────────────────────────────
# Google Gemini Flash 2.5 (Free Tier)
GEMINI_API_KEY=

# ── Social Media Publishing ─────────────────────────────────────────
# Instagram (Creator Account — Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_CREATOR_ACCOUNT_ID=

# Facebook (Page Publishing)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Twitter/X (API v2 + v1.1 for media)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Aakash SMS ───────────────────────────────────────────────────────
AAKASH_SMS_TOKEN=
